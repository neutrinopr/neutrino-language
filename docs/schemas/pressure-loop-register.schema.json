{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutrino-lang.dev/schemas/pressure-loop-register.schema.json",
  "title": "Neutrino pressure-loop register",
  "description": "M6  pressure-loop register v2 (). v1 is retired: registers are explicit result/evidence rows with supportStatus, nullable currentArtifactOperation, and typed executable/refusal evidence references. The companion stdlib validator enforces the semantic obligations JSON Schema cannot fully express here: accepted iff class null; unresolved iff class 1/2/3 plus failedVerifierObligation; decision-required rows are class 3 with counterexample + linked decision; unsupported refusals are absent/unresolved with refusal evidence; present/partial support carries executable evidence; partial support has absent sibling rows; L3_RUNTIME and DESCRIPTIVE_ONLY stay orthogonal with no fabricated artifact design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "rows"
  ],
  "properties": {
    "kind": {
      "const": "neutrino.pressure-loop-register"
    },
    "schemaVersion": {
      "const": 2
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/registerRow"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableNonEmptyString": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "authorityWeightTier"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authorityWeightTier": {
          "enum": [
            "1",
            "2",
            "3"
          ]
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "executable",
            "refusal"
          ]
        },
        "ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "registerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "requirement",
        "provenance",
        "outcome",
        "class",
        "disposition",
        "failedVerifierObligation",
        "minimalCounterexample",
        "owner",
        "linkedDecision",
        "supportStatus",
        "currentArtifactOperation",
        "evidenceRefs"
      ],
      "properties": {
        "rowId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "outcome": {
          "enum": [
            "accepted",
            "unresolved"
          ]
        },
        "class": {
          "enum": [
            "1",
            "2",
            "3",
            null
          ]
        },
        "disposition": {
          "enum": [
            "L1_CORE",
            "L2_REFINEMENT",
            "L3_RUNTIME",
            "DESCRIPTIVE_ONLY",
            "UNSUPPORTED_REFUSED",
            "LANGUAGE_DECISION_REQUIRED",
            "LAYER_DECISION_REQUIRED"
          ]
        },
        "failedVerifierObligation": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "minimalCounterexample": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "linkedDecision": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "supportStatus": {
          "enum": [
            "present",
            "partial",
            "absent"
          ]
        },
        "currentArtifactOperation": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unresolved"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "enum": [
                  "1",
                  "2",
                  "3"
                ]
              },
              "failedVerifierObligation": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "LANGUAGE_DECISION_REQUIRED",
                  "LAYER_DECISION_REQUIRED"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "const": "3"
              },
              "minimalCounterexample": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "linkedDecision": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    }
  }
}
