{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutrino.dev/schemas/semantic-authority-report.schema.json",
  "title": "Neutrino semantic-authority discovery report",
  "description": "Deterministic  report. Findings are grouped by mechanically discovered governed backend and authority class; locations, hashes, and historical occurrence counts are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "mode",
    "governedBackends",
    "carveoutRegistry",
    "backends"
  ],
  "properties": {
    "kind": {
      "const": "neutrino.semantic-authority-report"
    },
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "enforce"
    },
    "governedBackends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "carveoutRegistry": {
      "const": "docs/security-primitive-carveout-registry.json"
    },
    "backends": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/backend"
      }
    }
  },
  "$defs": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "surfaces",
        "findings"
      ],
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "rule",
        "evidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  }
}
