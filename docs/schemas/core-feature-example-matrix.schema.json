{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neutrino/contracts/core-feature-example-matrix/v1",
  "title": "neutrino.core-feature-example-matrix",
  "description": "A deterministic measurement of compiler-derived semantic features exercised by committed domain examples.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "semanticProfileVersion", "vocabulary", "exampleCount", "examples", "featureCoverage", "gaps", "candidateVarianceGroups"],
  "properties": {
    "kind": {"const": "neutrino.core-feature-example-matrix"},
    "schemaVersion": {"const": 1},
    "semanticProfileVersion": {"type": "integer", "minimum": 1},
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "featureCount"],
      "properties": {
        "path": {"const": "docs/semantic-feature-vocabulary.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "featureCount": {"type": "integer", "minimum": 1}
      }
    },
    "exampleCount": {"type": "integer", "minimum": 1},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/example"}
    },
    "featureCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/featureCoverage"}
    },
    "gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z_]*:[a-z][a-z0-9_]*$"}
    },
    "candidateVarianceGroups": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateGroup"}
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expressionDepth", "effectCount", "effectGroupCount", "attestationCount", "computeCount", "operationSteps"],
      "properties": {
        "expressionDepth": {"type": "integer", "minimum": 0},
        "effectCount": {"type": "integer", "minimum": 0},
        "effectGroupCount": {"type": "integer", "minimum": 0},
        "attestationCount": {"type": "integer", "minimum": 0},
        "computeCount": {"type": "integer", "minimum": 0},
        "operationSteps": {"type": "integer", "minimum": 0}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "spec", "capabilityHash", "features", "metrics", "backendGoldens"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source": {"type": "string", "pattern": "^\\.ci/domain-packs/packs/.+/pack/source/.+\\.neu$"},
        "spec": {"type": "string", "pattern": "^\\.ci/domain-packs/packs/.+/pack/generated/capability-spec/capability-spec\\.json$"},
        "capabilityHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "backendGoldens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["solidity", "postgres"],
          "properties": {"solidity": {"type": "boolean"}, "postgres": {"type": "boolean"}}
        }
      }
    },
    "featureCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "examples"],
      "properties": {
        "feature": {"type": "string"},
        "examples": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "candidateGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "examples"],
      "properties": {
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "examples": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
