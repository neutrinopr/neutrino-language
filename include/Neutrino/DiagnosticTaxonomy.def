NEUTRINO_DIAG(Domain, "domain.import.unknown", Active, 191, "an l2.import names a registered capability but not at the imported version", Cpp)
NEUTRINO_DIAG(Domain, "domain.import.ambiguous", Active, 192, "an l2.import resolves to more than one registry entry", Cpp)
NEUTRINO_DIAG(Domain, "domain.import.cyclic", Active, 193, "the transitive l2.import graph contains a cycle", Cpp)
NEUTRINO_DIAG(Domain, "domain.import.ungoverned", Active, 194, "an l2.import's registry entry has no governed v2 sidecar, or that sidecar is invalid or fails its hash / identity pin", Cpp)
// ---- spec lifecycle field-specific schema codes (): the three GENUINELY NEW field codes for the
// synthesized-lifecycle enum fields that have no existing semantic code (the reserved kernel.state/
// idempotency/effect codes cover different, IR-verifier semantics). Registered APPEND-ONLY at the active
// tail at their original ordinals 199-201; ordinals 195-198 were allocated to four field codes that were
// withdrawn in favour of reusing the kernel.binding.*/kernel.attest.* codes (below, now emitter Both) and
// are left as permanent GAPS — the precedence namespace is append-only, withdrawn ordinals are not recycled.
NEUTRINO_DIAG(Spec, "spec.terminal_kind", Active, 199, "a capability-spec state terminal kind is invalid", Validator)
NEUTRINO_DIAG(Spec, "spec.transition_idempotency", Active, 200, "a capability-spec transition idempotency policy is invalid", Validator)
NEUTRINO_DIAG(Spec, "spec.transition_effect", Active, 201, "a capability-spec transition effect kind is invalid", Validator)
// ---- obligation (L1 v0.2 O1, ): the structural verifier for the first-class
// undertaking op. Distinct from effect execution; every reference is resolved in
// the enclosing procedure with no domain/backend vocabulary. Root-cause ordered:
// identity/obligor, then scope, then predicate, then the authorized effect set.
NEUTRINO_DIAG(Kernel, "kernel.obligation.identity", Active, 202, "an obligation declares an empty or whitespace identity (sym_name)", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.obligor", Active, 203, "an obligation's obligor is empty or does not resolve to exactly one declared participant", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.scope", Active, 204, "an obligation's scoped beneficiary or authority is empty or does not resolve to exactly one declared participant", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.ambiguous_ref", Active, 205, "an obligation reference (obligor/scope/effect) resolves to more than one declaration of that name — order-dependent resolution is refused", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.predicate", Active, 206, "an obligation's activation predicate is missing (when text and when_ast must both be present)", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.effects_empty", Active, 207, "an obligation authorizes an empty (vacuous) set of value effects", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.not_an_effect", Active, 208, "an obligation's effect reference does not resolve to a declared value effect (debit/credit) — it is absent, or names a participant/obligation/other op", Cpp)
NEUTRINO_DIAG(Kernel, "kernel.obligation.duplicate_effect", Active, 209, "an obligation declares the same value-effect reference more than once", Cpp)
