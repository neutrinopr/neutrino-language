//===- DiagnosticTaxonomy.def - the declarative diagnostic taxonomy -------===//
//
// The SINGLE DECLARATIVE SOURCE of the shared failure taxonomy (M5 WP1c ;
// declarative-source migration M5  D1, ). Each row is one diagnostic
// code; the C++ table (lib/DiagnosticTaxonomy.cpp) expands these rows via an
// X-macro, and the auditor-facing JSON (`--diagnostic-taxonomy`,
// docs/diagnostic-taxonomy.json) + docs/language/DIAGNOSTIC_TAXONOMY.md are emitted from
// that table — so ALL of them derive from this file. A drift check
// (self-test [76]/[78]) byte-matches the emitted JSON against the committed
// docs, so the generated artifacts cannot diverge from this source.
//
//   NEUTRINO_DIAG(Category, "code", Status, precedence, "summary", Emitter)
//
// Category : a DiagCategory enum name (Frontend/Kernel/Value/Expr/Scenario/
//            Security/Generate/Equivalence/Classification/Spec/Profile/Legality/
//            Realization/View/Observation).
// Status   : Active (emitted today) | Reserved (bound but not yet emitted).
// precedence: root-cause rank, LOWER = more primary. Spaced so a follow-up rule
//            slots in without renumbering. Rows are kept in precedence order.
// Emitter  : Cpp (a C++ tool) | Validator (a stdlib Python validator) | Both.
//
// The includer defines NEUTRINO_DIAG before #include and #undefs it after.
//
//===----------------------------------------------------------------------===//

#ifndef NEUTRINO_DIAG
#error "define NEUTRINO_DIAG(Category, Code, Status, Precedence, Summary, Emitter) before including DiagnosticTaxonomy.def"
#endif

// ---- frontend: source text -> valid IR (most primary: no IR, no anything)
NEUTRINO_DIAG(Frontend, "source.io", Active, 10, "the source/scenario file could not be read", Cpp)
NEUTRINO_DIAG(Frontend, "source.parse", Active, 11, "the .neu source could not be lowered to valid IR", Cpp)
