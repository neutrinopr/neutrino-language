// NEGATIVE fixture () — reimbursement mismatch.
// The Sponsor reimbursement-funding leg funds %commission instead of %reimbursement, so the
// promo-pool debits no longer equal the Promoter + Fulfiller payouts and `assert balanced`
// fails at the translator. This is the fail-closed "reimbursement integrity" negative.

procedure core_promo_campaign {
    trigger promo_redemption_reported
    version "1.0.0"

    participant Sponsor {
        role               = "sponsor"
        org                = "sponsorco"
        binding            = "to_be_bound"
        bind_runtimes      = ["evm"]
        bind_min_assurance = "A2"
    }
    participant Promoter {
        role = "promoter"
        org  = "promoterco"
    }
    participant Fulfiller {
        role = "fulfiller"
        org  = "fulfillerco"
    }

    allow "sponsorco" with "promoterco" {
        "sponsorco" as "sponsor"
        "promoterco" as "promoter"
    }
    allow "sponsorco" with "fulfillerco" {
        "sponsorco" as "sponsor"
        "fulfillerco" as "fulfiller"
    }
    allow "promoterco" with "fulfillerco" {
        "promoterco" as "promoter"
        "fulfillerco" as "fulfiller"
    }

    input redemption_id : string
    input sponsor_id    : party
    input promoter_id   : party
    input fulfiller_id  : party
    input commission    : money
    input reimbursement : money
    input currency      : currency

    debit sponsor_commission_funding {
        ledger          = "sponsor.promo_pool"
        owner           = "sponsor"
        participant     = "Sponsor"
        party           = %sponsor_id
        amount          = %commission
        currency        = %currency
        idempotency_key = %redemption_id
    }

    credit promoter_commission {
        ledger          = "promoter.commission"
        owner           = "promoter"
        participant     = "Promoter"
        party           = %promoter_id
        amount          = %commission
        currency        = %currency
        idempotency_key = %redemption_id
    }

    // BUG: funds the commission amount again instead of %reimbursement -> not balanced.
    debit sponsor_reimbursement_funding {
        ledger          = "sponsor.promo_pool"
        owner           = "sponsor"
        participant     = "Sponsor"
        party           = %sponsor_id
        amount          = %commission
        currency        = %currency
        idempotency_key = %redemption_id
    }

    credit fulfiller_reimbursement {
        ledger          = "fulfiller.reimbursement"
        owner           = "fulfiller"
        participant     = "Fulfiller"
        party           = %fulfiller_id
        amount          = %reimbursement
        currency        = %currency
        idempotency_key = %redemption_id
    }

    assert balanced
}
