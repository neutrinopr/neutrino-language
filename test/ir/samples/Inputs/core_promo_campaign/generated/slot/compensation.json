        { "entry": "promoter_commission", "ledger": "promoter.commission", "inverseOf": "credit" },
        { "entry": "sponsor_reimbursement_funding", "ledger": "sponsor.promo_pool", "inverseOf": "debit" },
        { "entry": "fulfiller_reimbursement", "ledger": "fulfiller.reimbursement", "inverseOf": "credit" }
      ],
      "idempotency": "core_promo_campaign:<idempotency_key>:compensation"
    }
  },
  "nonCompensable": ["OPEN", "NEGOTIATE", "PROPOSE", "REJECT", "CLOSE"],
  "invariantAfterCompensation": "balanced"
}
