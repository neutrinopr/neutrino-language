pragma solidity ^0.8.20;

/// Generated by the Neutrino Translator from verified MLIR.
/// COORDINATION CONTRACT — not the source of truth and not fund custody.
/// It records coordination checkpoints (status, attestations, net positions)
/// that participants accept; authoritative state stays in their own systems.
/// All coordination state is keyed by the workflow key (the idempotency key),
/// so distinct workflow instances never share status, totals, or net positions.
contract CoreDocumentEscrow {
    enum Status { None, Reconciled }

    event EscrowOpened(string escrow_id);
    event BuyerEscrowDebited(string party, uint256 amount, string currency);
    event EscrowHoldingCredited(string party, uint256 amount, string currency);
    event EscrowReleaseDebited(string party, uint256 amount, string currency);
    event SellerSettlementCredited(string party, uint256 amount, string currency);
    event CoreDocumentEscrowReconciled(string escrow_id);

    mapping(bytes32 => Status) public statusOf;
    mapping(bytes32 => bool) public attested;
    mapping(bytes32 => mapping(string => int256)) public net;  // key -> ledger -> net
    mapping(bytes32 => uint256) public debitTotal;             // key -> total debited
    mapping(bytes32 => uint256) public creditTotal;            // key -> total credited

    function attest(string calldata u_escrow_id) external {
        bytes32 _k = keccak256(bytes(u_escrow_id));
        require(statusOf[_k] == Status.None, "bad transition");
        attested[_k] = true;
    }

    function execute(string calldata u_escrow_id, string calldata u_buyer_id, string calldata u_agent_id, string calldata u_seller_id, uint256 u_amount, uint256 u_agreed_amount, string calldata u_currency) external {
        bytes32 _k = keccak256(bytes(u_escrow_id));
        require(statusOf[_k] == Status.None, "replay");
        require(attested[_k], "missing attestation");
        emit EscrowOpened(u_escrow_id);


        net[_k]["buyer.escrow"] -= int256(u_amount);
        debitTotal[_k] += u_amount;
        emit BuyerEscrowDebited(u_buyer_id, u_amount, u_currency);
        net[_k]["escrow.holding"] += int256(u_amount);
        creditTotal[_k] += u_amount;
        emit EscrowHoldingCredited(u_agent_id, u_amount, u_currency);
        if (u_amount >= u_agreed_amount) {
            net[_k]["escrow.holding"] -= int256(u_amount);
            debitTotal[_k] += u_amount;
            emit EscrowReleaseDebited(u_agent_id, u_amount, u_currency);
        }
        if (u_amount >= u_agreed_amount) {
            net[_k]["seller.proceeds"] += int256(u_amount);
            creditTotal[_k] += u_amount;
            emit SellerSettlementCredited(u_seller_id, u_amount, u_currency);
        }

        require(debitTotal[_k] == creditTotal[_k], "not balanced");
        statusOf[_k] = Status.Reconciled;
        emit CoreDocumentEscrowReconciled(u_escrow_id);
    }
}
