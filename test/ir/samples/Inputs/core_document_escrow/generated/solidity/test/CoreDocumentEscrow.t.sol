pragma solidity ^0.8.20;

import "../src/CoreDocumentEscrow.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

/// Generated by the Neutrino Translator from scenario "core_document_escrow_happy_path".
contract CoreDocumentEscrowTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    CoreDocumentEscrow c;

    string constant ESCROW_ID = "esc-001";
    string constant BUYER_ID = "buyer-001";
    string constant AGENT_ID = "agent-001";
    string constant SELLER_ID = "seller-001";
    uint256 constant AMOUNT = 5000;
    uint256 constant AGREED_AMOUNT = 5000;
    string constant CURRENCY = "EUR";
    string constant ESCROW_ID_2 = "esc-001-2";


    event EscrowOpened(string escrow_id);
    event BuyerEscrowDebited(string party, uint256 amount, string currency);
    event EscrowHoldingCredited(string party, uint256 amount, string currency);
    event EscrowReleaseDebited(string party, uint256 amount, string currency);
    event SellerSettlementCredited(string party, uint256 amount, string currency);
    event CoreDocumentEscrowReconciled(string escrow_id);

    function setUp() public {
        c = new CoreDocumentEscrow();
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(ESCROW_ID));
    }

    function test_happy_path_reaches_reconciled_with_events() public {
        bytes32 _k = _key();
        c.attest(ESCROW_ID);
        vm.expectEmit(true, true, true, true);
        emit EscrowOpened(ESCROW_ID);
        vm.expectEmit(true, true, true, true);
        emit BuyerEscrowDebited(BUYER_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit EscrowHoldingCredited(AGENT_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit EscrowReleaseDebited(AGENT_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit SellerSettlementCredited(SELLER_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit CoreDocumentEscrowReconciled(ESCROW_ID);
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        require(uint256(c.statusOf(_k)) == uint256(CoreDocumentEscrow.Status.Reconciled), "status");
        require(c.debitTotal(_k) == c.creditTotal(_k), "balanced");
        require(c.debitTotal(_k) == AMOUNT + AMOUNT, "debit total");
        require(c.net(_k, "buyer.escrow") == int256(-5000), "net buyer.escrow");
        require(c.net(_k, "escrow.holding") == int256(0), "net escrow.holding");
        require(c.net(_k, "seller.proceeds") == int256(5000), "net seller.proceeds");
    }

    function test_replay_is_safe_no_double_debit() public {
        bytes32 _k = _key();
        c.attest(ESCROW_ID);
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        vm.expectRevert(bytes("replay"));
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        require(c.debitTotal(_k) == AMOUNT + AMOUNT, "no double debit");
    }

    function test_missing_attestation_rejected() public {
        vm.expectRevert(bytes("missing attestation"));
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
    }

    function test_invalid_transition_ordering_rejected() public {
        c.attest(ESCROW_ID);
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        vm.expectRevert(bytes("bad transition"));
        c.attest(ESCROW_ID);
    }

    function test_balanced_invariant_holds() public {
        bytes32 _k = _key();
        c.attest(ESCROW_ID);
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        require(c.debitTotal(_k) == c.creditTotal(_k), "debit==credit");
    }

    function test_workflows_are_isolated_per_key() public {
        c.attest(ESCROW_ID);
        c.execute(ESCROW_ID, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        c.attest(ESCROW_ID_2);
        c.execute(ESCROW_ID_2, BUYER_ID, AGENT_ID, SELLER_ID, AMOUNT, AGREED_AMOUNT, CURRENCY);
        // each workflow key keeps its own totals; no sharing/double counting
        require(c.debitTotal(keccak256(bytes(ESCROW_ID))) == AMOUNT + AMOUNT, "k1 total");
        require(c.debitTotal(keccak256(bytes(ESCROW_ID_2))) == AMOUNT + AMOUNT, "k2 total");
    }
}
