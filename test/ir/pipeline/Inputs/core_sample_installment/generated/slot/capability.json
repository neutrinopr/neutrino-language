{
  "kind": "neutrino.slot-capability",
  "capability": "coordinate.core_sample_installment",
  "capabilityVersion": "0.1.0",
  "procedure": "core_sample_installment",
  "trigger": "purchase_financed",
  "parties": [
    "merchant_id",
    "issuer_id"
  ],
  "ledgerOwners": [
    "acquirer",
    "issuer"
  ],
  "operations": [
    "OPEN",
    "NEGOTIATE",
    "PROPOSE",
    "COMMIT",
    "REJECT",
    "COMPENSATE",
    "CLOSE"
  ],
  "computed": [
    "subsidy"
  ],
  "ledgers": [
    "acquirer.merchant_balance",
    "issuer.promotional_receivable"
  ],
  "evidenceInputs": [],
  "partyTypedInputs": [],
  "typedInputs": [
    {
      "name": "transaction_id",
      "type": "string"
    },
    {
      "name": "merchant_id",
      "type": "string"
    },
    {
      "name": "issuer_id",
      "type": "string"
    },
    {
      "name": "principal",
      "type": "money"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "subsidy_pct",
      "type": "decimal"
    }
  ],
  "entries": [
    {
      "name": "merchant_subsidy",
      "kind": "debit",
      "ledger": "acquirer.merchant_balance",
      "owner": "acquirer",
      "party": {
        "input": "merchant_id"
      },
      "amount": {
        "input": "subsidy"
      },
      "currency": {
        "input": "currency"
      },
      "idempotencyKey": {
        "input": "transaction_id"
      }
    },
    {
      "name": "issuer_receivable",
      "kind": "credit",
      "ledger": "issuer.promotional_receivable",
      "owner": "issuer",
      "party": {
        "input": "issuer_id"
      },
      "amount": {
        "input": "subsidy"
      },
      "currency": {
        "input": "currency"
      },
      "idempotencyKey": {
        "input": "transaction_id"
      }
    }
  ]
