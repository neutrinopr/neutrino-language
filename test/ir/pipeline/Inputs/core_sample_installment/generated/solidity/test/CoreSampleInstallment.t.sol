pragma solidity ^0.8.20;

import "../src/CoreSampleInstallment.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

/// Generated by the Neutrino Translator from scenario "core_sample_installment_happy_path".
contract CoreSampleInstallmentTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    CoreSampleInstallment c;

    string constant TRANSACTION_ID = "txn-001";
    string constant MERCHANT_ID = "merchant-001";
    string constant ISSUER_ID = "issuer-001";
    uint256 constant PRINCIPAL = 100000;
    string constant CURRENCY = "EUR";
    uint256 constant SUBSIDY_PCT = 10;
    string constant TRANSACTION_ID_2 = "txn-001-2";
    uint256 constant EXPECT_SUBSIDY = 10000;

    event PurchaseFinanced(string transaction_id);
    event SubsidyComputed(uint256 value);
    event MerchantSubsidyDebited(string party, uint256 amount, string currency);
    event IssuerReceivableCredited(string party, uint256 amount, string currency);
    event CoreSampleInstallmentReconciled(string transaction_id);

    function setUp() public {
        c = new CoreSampleInstallment();
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(TRANSACTION_ID));
    }

    function test_happy_path_reaches_reconciled_with_events() public {
        bytes32 _k = _key();
        c.attest(TRANSACTION_ID);
        vm.expectEmit(true, true, true, true);
        emit PurchaseFinanced(TRANSACTION_ID);
        vm.expectEmit(true, true, true, true);
        emit SubsidyComputed(EXPECT_SUBSIDY);
        vm.expectEmit(true, true, true, true);
        emit MerchantSubsidyDebited(MERCHANT_ID, EXPECT_SUBSIDY, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit IssuerReceivableCredited(ISSUER_ID, EXPECT_SUBSIDY, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit CoreSampleInstallmentReconciled(TRANSACTION_ID);
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        require(uint256(c.statusOf(_k)) == uint256(CoreSampleInstallment.Status.Reconciled), "status");
        require(c.debitTotal(_k) == c.creditTotal(_k), "balanced");
        require(c.debitTotal(_k) == EXPECT_SUBSIDY, "debit total");
        require(c.net(_k, "acquirer.merchant_balance") == int256(-10000), "net acquirer.merchant_balance");
        require(c.net(_k, "issuer.promotional_receivable") == int256(10000), "net issuer.promotional_receivable");
    }

    function test_replay_is_safe_no_double_debit() public {
        bytes32 _k = _key();
        c.attest(TRANSACTION_ID);
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        vm.expectRevert(bytes("replay"));
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        require(c.debitTotal(_k) == EXPECT_SUBSIDY, "no double debit");
    }

    function test_missing_attestation_rejected() public {
        vm.expectRevert(bytes("missing attestation"));
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
    }

    function test_invalid_transition_ordering_rejected() public {
        c.attest(TRANSACTION_ID);
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        vm.expectRevert(bytes("bad transition"));
        c.attest(TRANSACTION_ID);
    }

    function test_balanced_invariant_holds() public {
        bytes32 _k = _key();
        c.attest(TRANSACTION_ID);
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        require(c.debitTotal(_k) == c.creditTotal(_k), "debit==credit");
    }

    function test_workflows_are_isolated_per_key() public {
        c.attest(TRANSACTION_ID);
        c.execute(TRANSACTION_ID, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        c.attest(TRANSACTION_ID_2);
        c.execute(TRANSACTION_ID_2, MERCHANT_ID, ISSUER_ID, PRINCIPAL, CURRENCY, SUBSIDY_PCT);
        // each workflow key keeps its own totals; no sharing/double counting
        require(c.debitTotal(keccak256(bytes(TRANSACTION_ID))) == EXPECT_SUBSIDY, "k1 total");
        require(c.debitTotal(keccak256(bytes(TRANSACTION_ID_2))) == EXPECT_SUBSIDY, "k2 total");
    }
}
