// Frontend NEGATIVE (M5 oracle S1, ): an attestation policy must attach to a declared `evidence`
// input. Here it targets `amount` (money), a cross-op check only the frontend can make (it holds the
// input table); the IR verifier sees a single op and cannot. neutrino-gen must fail closed with no
// capability-spec written.
//
// RUN: %not %neutrino-gen --target=capability-spec %s -o %t.d 2>&1 | %FileCheck %s
// RUN: test ! -e %t.d/capability-spec.json
// CHECK: attest 'amount' must reference an input of type 'evidence'
procedure neg_attest_non_evidence {
    trigger t
    participant Buyer {
        role = "buyer"
        org  = "buyerco"
    }
    participant Seller {
        role = "seller"
        org  = "sellerco"
    }
    allow "buyerco" with "sellerco" {
        "buyerco" as "buyer"
        "sellerco" as "seller"
    }
    input order_id : string
    input buyer_id : party
    input seller_id : party
    input amount   : money
    input currency : currency
    attest amount {
        quorum           = 2
        observer_set     = "oracles"
        canonicalization = "exact"
        fallback         = "abort"
    }
    debit buyer_pay {
        ledger          = "buyer.escrow"
        owner           = "buyer"
        participant     = "Buyer"
        party           = %buyer_id
        amount          = %amount
        currency        = %currency
        idempotency_key = %order_id
    }
    credit seller_settle {
        ledger          = "seller.proceeds"
        owner           = "seller"
        participant     = "Seller"
        party           = %seller_id
        amount          = %amount
        currency        = %currency
        idempotency_key = %order_id
    }
    assert balanced
}
