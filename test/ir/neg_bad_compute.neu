// Negative fixture: a compute expression that references an undeclared name.
// %principal is never declared, so the frontend must reject the compute
// ("references '...', which is not a declared input or computed value").
procedure bad_compute {
    input amount : money

    compute subsidy = principal * 10 / 100

    debit d {
        ledger          = "a.b"
        owner           = "o"
        party           = "p"
        amount          = %amount
        currency        = "EUR"
        idempotency_key = "k"
    }

    credit c {
        ledger          = "a.b"
        owner           = "o"
        party           = "p"
        amount          = %amount
        currency        = "EUR"
        idempotency_key = "k"
    }

    assert balanced
}

// Frontend parser/verifier NEGATIVE (S5/): neutrino-translate must REJECT this
// malformed source. %not asserts the non-zero exit; FileCheck matches the diagnostic.
// (RUN/CHECK are appended so the code's line numbers stay stable for the language-
// intelligence tests that also consume this fixture.)
// RUN: %not %neutrino-translate %s -o %t 2>&1 | %FileCheck %s
// CHECK: is not a declared input or computed value
