// [87] the spec-legality gate fails closed on the PostgreSQL render path too — before any SQL, and the
// in-process C++ gate agrees with the canonical Python gate.
//
// DEFINE: %{soa} = %curated3
// DEFINE: %{src} = %curated3-source
// DEFINE: %{scn} = %curated3-scenario
// DEFINE: %{prof} = %examples/target-profiles/postgres.target-profile.json
// (a) an unsupported REQUIRED feature -> EXIT_LEGALITY(6), NO SQL at all (procedure.sql AND schema.sql),
//     legality.unsupported_feature.
// RUN: %neutrino-gen --target=postgres --scenario=%{scn} --profile=%S/restrictive_postgres.target-profile.json %{src} -o %t.neg; [ $? -eq 6 ]
// RUN: test ! -e %t.neg/procedure.sql
// RUN: test ! -e %t.neg/schema.sql
// RUN: %FileCheck --check-prefix=UNSUP %s < %t.neg/diagnostics.json
// (b) a wrong-target (solidity) profile gating a postgres render -> exit 6, legality.target_mismatch,
//     and (before any SQL) neither procedure.sql nor schema.sql.
// RUN: %neutrino-gen --target=postgres --scenario=%{scn} --profile=%examples/target-profiles/solidity.target-profile.json %{src} -o %t.mis; [ $? -eq 6 ]
// RUN: test ! -e %t.mis/procedure.sql
// RUN: test ! -e %t.mis/schema.sql
// RUN: %FileCheck --check-prefix=MISM %s < %t.mis/diagnostics.json
// (c) the legal postgres profile still renders the procedure.
// RUN: %neutrino-gen --target=postgres --scenario=%{scn} --profile=%{prof} %{src} -o %t.pos
// RUN: test -e %t.pos/procedure.sql
// (d) parity: the canonical Python gate agrees on the SAME capability-spec.json (reject / accept).
// RUN: %neutrino-gen --target=capability-spec %{src} -o %t.spec
// RUN: %not python3 %scripts/gates/check_spec_legality.py %t.spec/capability-spec.json --profile=%S/restrictive_postgres.target-profile.json --target=postgres
// RUN: python3 %scripts/gates/check_spec_legality.py %t.spec/capability-spec.json --profile=%{prof} --target=postgres
// UNSUP: legality.unsupported_feature
// UNSUP: invariant:balanced
// MISM: legality.target_mismatch
