// L2RED: "concept": "assessor_review"
// L2RED: "feature": "attestation:quorum"
//
// RECURSE: reduction edge targets undeclared L1 feature 'stage_b'
//
// ORDERED: guard references 'after'
// ORDDIAG: "code": "source.parse"
// MISS: "no-progress"
//
// ROW: "class": "3"
// ROW: "disposition": "LAYER_DECISION_REQUIRED"
// ROW: "failedVerifierObligation": "L2 cannot preserve the required assessor-before-reviewer dependency through reduction"
// ROW: "linkedDecision": "neutrino-
