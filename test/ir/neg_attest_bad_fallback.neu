// Frontend NEGATIVE (M5 oracle S1, ): the frontend fails closed on a malformed attestation
// policy at parse time, using the same shared contract validator as the IR verifier. Here the
// fallback is not one of abort/escalate/degrade — safety over liveness must be a DECLARED behavior.
// neutrino-gen exits non-zero and writes no capability-spec.
//
// RUN: %not %neutrino-gen --target=capability-spec %s -o %t.d 2>&1 | %FileCheck %s
// RUN: test ! -e %t.d/capability-spec.json
// CHECK: unsupported attestation fallback 'panic'
procedure neg_attest_bad_fallback {
    trigger t
    participant Buyer {
        role = "buyer"
        org  = "buyerco"
    }
    participant Seller {
        role = "seller"
        org  = "sellerco"
    }
    allow "buyerco" with "sellerco" {
        "buyerco" as "buyer"
        "sellerco" as "seller"
    }
    input order_id       : string
    input buyer_id       : party
    input seller_id      : party
    input amount         : money
    input currency       : currency
    input delivery_proof : evidence
    attest delivery_proof {
        quorum           = 2
        observer_set     = "oracles"
        canonicalization = "exact"
        fallback         = "panic"
    }
    debit buyer_pay {
        ledger          = "buyer.escrow"
        owner           = "buyer"
        participant     = "Buyer"
        party           = %buyer_id
        amount          = %amount
        currency        = %currency
        idempotency_key = %order_id
    }
    credit seller_settle {
        ledger          = "seller.proceeds"
        owner           = "seller"
        participant     = "Seller"
        party           = %seller_id
        amount          = %amount
        currency        = %currency
        idempotency_key = %order_id
    }
    assert balanced
}
