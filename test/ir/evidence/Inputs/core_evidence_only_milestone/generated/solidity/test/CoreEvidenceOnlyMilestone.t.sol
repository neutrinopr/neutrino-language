pragma solidity ^0.8.20;

import "../src/CoreEvidenceOnlyMilestone.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

contract MockQuorumGuard {
    mapping(bytes32 => bool) public accepted;
    function setAccepted(bytes32 claimId, bool v) external {
        accepted[claimId] = v;
    }
    function isAccepted(bytes32 claimId) external view returns (bool) {
        return accepted[claimId];
    }
}

/// Generated by the Neutrino Translator from scenario "core_evidence_only_milestone_happy_path".
contract CoreEvidenceOnlyMilestoneTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    CoreEvidenceOnlyMilestone c;
    MockQuorumGuard guard;

    string constant MILESTONE_ID = "ms-il-it-001-origin";
    string constant SHIPMENT_ID = "shipment-il-it-001";
    string constant MILESTONE_KIND = "origin_carrier_handoff";
    string constant CUSTODY_FROM = "shipper-il-001";
    string constant CUSTODY_TO = "carrier-il-001";
    string constant MILESTONE_EVIDENCE = "sha256:1111111111111111111111111111111111111111111111111111111111111111";
    string constant MILESTONE_ID_2 = "ms-il-it-001-origin-2";

    event CoreEvidenceOnlyMilestoneAccepted(string milestone_id);

    function setUp() public {
        guard = new MockQuorumGuard();
        c = new CoreEvidenceOnlyMilestone(address(guard));
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(MILESTONE_ID));
    }

    function test_accept_records_evidence_and_emits() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(MILESTONE_ID)), true);
        vm.expectEmit(true, true, true, true);
        emit CoreEvidenceOnlyMilestoneAccepted(MILESTONE_ID);
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(CoreEvidenceOnlyMilestone.Status.Accepted), "accepted");
    }

    function test_replay_is_refused() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(MILESTONE_ID)), true);
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        vm.expectRevert(bytes("replay"));
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(CoreEvidenceOnlyMilestone.Status.Accepted), "still accepted");
    }

    function test_unaccepted_quorum_rejected() public {
        vm.expectRevert(bytes("quorum not accepted"));
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
    }

    function test_accepted_quorum_proceeds() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(MILESTONE_ID)), true);
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(CoreEvidenceOnlyMilestone.Status.Accepted), "gated status");
    }

    function test_instances_are_isolated_per_key() public {
        guard.setAccepted(keccak256(bytes(MILESTONE_ID)), true);
        c.accept(MILESTONE_ID, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        guard.setAccepted(keccak256(bytes(MILESTONE_ID_2)), true);
        c.accept(MILESTONE_ID_2, SHIPMENT_ID, MILESTONE_KIND, CUSTODY_FROM, CUSTODY_TO, MILESTONE_EVIDENCE);
        // each instance key keeps its own status; no sharing
        require(uint256(c.statusOf(keccak256(bytes(MILESTONE_ID)))) == uint256(CoreEvidenceOnlyMilestone.Status.Accepted), "k1 status");
        require(uint256(c.statusOf(keccak256(bytes(MILESTONE_ID_2)))) == uint256(CoreEvidenceOnlyMilestone.Status.Accepted), "k2 status");
    }
}
