pragma solidity ^0.8.20;

/// The on-chain M-of-N quorum acceptance guard (/) this coordination is gated by.
/// A claimId is accepted only after >= M distinct authorized observers signed the canonical
/// claim (verified in ThresholdQuorumAcceptance). The coordination keys acceptance by its
/// instance key, so it can never proceed on unattested evidence.
interface IThresholdQuorumAcceptance {
    function isAccepted(bytes32 claimId) external view returns (bool);
    function acceptedExecutionClaim(bytes32 claimId) external view returns (bytes32);
}

/// Generated by the Neutrino Translator from verified MLIR.
/// EVIDENCE-ONLY COORDINATION — records ACCEPTED attested evidence by instance key and moves
/// NO ledger value (no debit/credit, no net positions). Participants accept the on-chain
/// acceptance record; authoritative state stays in their own systems. State is keyed by the
/// instance key (the idempotency key), so distinct instances never share status.
contract CoreEvidenceOnlyMilestone {
    enum Status { None, Accepted }

    event CoreEvidenceOnlyMilestoneAccepted(string milestone_id);

    mapping(bytes32 => Status) public statusOf;
    IThresholdQuorumAcceptance public immutable acceptanceGuard;

    constructor(address acceptanceGuard_) {
        require(acceptanceGuard_ != address(0), "guard required");
        acceptanceGuard = IThresholdQuorumAcceptance(acceptanceGuard_);
    }

    function accept(string calldata u_milestone_id, string calldata, string calldata, string calldata, string calldata, string calldata) external {
        bytes32 _k = keccak256(bytes(u_milestone_id));
        require(statusOf[_k] == Status.None, "replay");
        require(acceptanceGuard.isAccepted(_k), "quorum not accepted");
        statusOf[_k] = Status.Accepted;
        emit CoreEvidenceOnlyMilestoneAccepted(u_milestone_id);
    }
}
