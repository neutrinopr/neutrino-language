// Two instance-key declarations are ambiguous — the parser refuses a duplicate.
// RUN: %not %neutrino-translate %s 2>&1 | %FileCheck %s
// CHECK: duplicate instance_key declaration
procedure bad_key_duplicate {
    input shipment_ref  : string
    input other_ref     : string
    input delivery_proof : evidence

    instance_key shipment_ref
    instance_key other_ref

    attest delivery_proof {
        quorum           = 1
        observer_set     = "oracles"
        canonicalization = "exact"
        fallback         = "abort"
    }
}
