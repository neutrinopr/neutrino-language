# Generated artifacts — regenerate with `make demo`
/build/

# C++ MLIR build tree (cmake/ninja) — recreate with `make build`
/out/

# Sanitizer / coverage developer-lane build trees () — recreate with `make asan|ubsan|cpp-coverage`
/out-asan/
/out-ubsan/
/out-asan-ubsan/
/out-cov/

# Release artifacts (tarball/.deb/SHA256SUMS/manifest) — recreate with `make release`
/dist/

# Foundry toolchain on the SSD — recreate with `make setup-foundry`
/.foundry/

# Cross-repository CI/local tool checkout — recreate with `make setup-build-tools-verifier`
/.ci/

# JVM wrapper build outputs
/jvm-wrapper/build/
/jvm-wrapper/.gradle/

# macOS
.DS_Store
.idea/

# lit working artifacts (normally written to the build tree; ignore if run against source)
test/ir/Output/
test/ir/.lit_test_times.txt

# [] generalism matrix runner output (generated from the built binaries; not committed —
# embeds build-derived artifact/provenance hashes, regenerated by `make run-generalism-matrix`)
test/generalism/results/

# Python bytecode is execution residue, never an M6 input or evidence.
__pycache__/
*.pyc
