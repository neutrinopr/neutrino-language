//===- SolidityTemporalIdiomRecipes.td - temporal Solidity recipes -------===//
//
// Complete declarative composition for the temporal per-policy rail. Inputs
// are finalized projection facts in projection-owned order. The recipe chooses
// every target node and its nesting; the provider only binds typed fields and
// performs closed leaf formatting.
//
//===----------------------------------------------------------------------===//

def FinalizedTemporalExecution : FinalizedType<"FinalizedTemporalExecution", [
  FinalizedField<"procedure", "TargetIdentifierAtom">,
  FinalizedField<"instanceKey", "TargetIdentifierAtom">,
  FinalizedField<"replayKey", "TargetIdentifierAtom">,
  FinalizedField<"invokedEvent", "TargetIdentifierAtom">,
  FinalizedField<"coordinationIdentity", "TypedStringLiteral">,
  FinalizedField<"claimInputCount", "CardinalityAtom">,
  FinalizedField<"groupCount", "CardinalityAtom">
]>;
def FinalizedTemporalRole : FinalizedType<"FinalizedTemporalRole", [
  FinalizedField<"status", "LifecycleStatusAtom">
]>;
def FinalizedTemporalPolicy : FinalizedType<"FinalizedTemporalPolicy", [
  FinalizedField<"name", "TargetIdentifierAtom">,
  FinalizedField<"ordinal", "PolicyOrdinal">
]>;
def FinalizedTemporalParam : FinalizedType<"FinalizedTemporalParam", [
  FinalizedField<"name", "TargetIdentifierAtom">,
  FinalizedField<"type", "FinalizedTargetType">,
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalClaimInput : FinalizedType<"FinalizedTemporalClaimInput", [
  FinalizedField<"name", "TypedStringLiteral">,
  FinalizedField<"type", "FinalizedTargetType">,
  FinalizedField<"category", "TypedStringLiteral">,
  FinalizedField<"value", "FinalizedTypedOperand">,
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalCompute : FinalizedType<"FinalizedTemporalCompute", [
  FinalizedField<"name", "TargetIdentifierAtom">,
  FinalizedField<"expression", "FinalizedExpressionLeaf">,
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalGroup : FinalizedType<"FinalizedTemporalGroup", [
  FinalizedField<"policy", "TargetIdentifierAtom">,
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalPosting : FinalizedType<"FinalizedTemporalPosting", [
  FinalizedField<"name", "TargetIdentifierAtom">,
  FinalizedField<"direction", "PostingDirectionAtom">,
  FinalizedField<"ledger", "TypedStringLiteral">,
  FinalizedField<"party", "FinalizedTypedOperand">,
  FinalizedField<"amount", "FinalizedTypedOperand">,
  FinalizedField<"currency", "FinalizedTypedOperand">,
  FinalizedField<"memo", "TypedStringLiteral">,
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalBalance : FinalizedType<"FinalizedTemporalBalance", [
  FinalizedField<"ordinal", "SemanticOrdinal">
]>;
def FinalizedTemporalMemo : FinalizedType<"FinalizedTemporalMemo">;

def SolIdentifierEscapeHook : RegisterLeafHook<
  "solidity.identifier.escape", HookIdentifierEscape,
  "solidityEscapeIdentifier">;
def SolStringEscapeHook : RegisterLeafHook<
  "solidity.string.escape", HookStringEscape, "solidityEscapeString">;
def SolTypeSpellHook : RegisterLeafHook<
  "solidity.type.spell", HookTypeSpell, "soliditySpellType">;
def SolOperandFormatHook : RegisterLeafHook<
  "solidity.operand.format", HookOperandFormat, "solidityFormatOperand">;
def SolExpressionLeafHook : RegisterLeafHook<
  "solidity.expression.leaf", HookExpressionLeaf,
  "solidityFormatExpression">;

