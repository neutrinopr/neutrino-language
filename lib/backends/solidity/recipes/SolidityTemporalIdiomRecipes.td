def SolTemporalContractNode : TargetNode<"SolTemporalContract",
  "SolTemporalContractModel", [
    TargetField<"name", "leaf", "EscapedIdentifier">,
    TargetField<"header", "nodes", "SolStatement", "many", 17, "17">,
    TargetField<"body", "nodes", "SolStatement", "many", 1, "unbounded">,
    TargetField<"sourceCanonicalizations", "nodes",
                "SolSourceCanonicalization", "many", 1, "unbounded">
  ], "temporal-contract">;

def SolTemporalContractRecipe : TargetIdiomRecipe<
  "solidity.temporal.contract.v1", "solidity",
  "QuorumAcceptance.PerPolicy", "Temporal", "NotApplicable", [
    One<"execution", "FinalizedTemporalExecution">,
    One<"initialRole", "FinalizedTemporalRole">,
    One<"successRole", "FinalizedTemporalRole">,
    Many<"sourceCanonicalizations", "FinalizedSourceCanonicalization", 1, "unbounded", "sourceCanonicalizations.ordinal">,
    Many<"temporalPolicies", "FinalizedTemporalPolicy", 1, "unbounded", "temporalPolicies.ordinal">,
    Many<"params", "FinalizedTemporalParam", 1, "unbounded", "params.ordinal">,
    Many<"claimInputs", "FinalizedTemporalClaimInput", 1, "unbounded", "claimInputs.ordinal">,
    Many<"computes", "FinalizedTemporalCompute", 0, "unbounded", "computes.ordinal">,
    Many<"effectGroups", "FinalizedTemporalGroup", 1, "unbounded", "effectGroups.ordinal">,
    RelatedMany<"groupPostings", "FinalizedTemporalPosting", 1, "unbounded", "groupPostings.ordinal", "effectGroups">,
    RelatedOptional<"groupPostingMemo", "FinalizedTemporalMemo", "groupPostings", PresenceMemo>,
    Many<"postings", "FinalizedTemporalPosting", 1, "unbounded", "postings.ordinal">,
    RelatedOptional<"postingMemo", "FinalizedTemporalMemo", "postings", PresenceMemo>,
    Many<"balanceAssertions", "FinalizedTemporalBalance", 1, "unbounded", "balanceAssertions.ordinal">
  ],
  "SolTemporalContractModel", CardinalityOne,
  Sequence<[
      Emit<"SolTemporalContract", [Hook<"name", "solidity.identifier.escape", "execution.procedure">, Nested<"header", Sequence<[
      Emit<"SolTemporalSpdx", []>,
      Emit<"SolTemporalPragma", []>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalEnvelopeImport", []>,
      Emit<"SolTemporalBlank", []>,
      Call<"solidity.guard-consumer.temporal.v1", []>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalGeneratedComment", []>,
      Emit<"SolTemporalCoordinationComment", []>,
      Emit<"SolTemporalCheckpointComment", []>,
      Emit<"SolTemporalAuthorityComment", []>,
      Emit<"SolTemporalKeyComment", []>,
      Emit<"SolTemporalIsolationComment", []>
    ]>>, Nested<"body", Sequence<[
      Emit<"SolStatusEnum", [Direct<"initial", "initialRole.status">, Direct<"success", "successRole.status">]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalTriggerEvent", [Hook<"name", "solidity.identifier.escape", "execution.invokedEvent">, Nested<"params", Sequence<[
      Emit<"SolTemporalStringKeyParam", [Hook<"name", "solidity.identifier.escape", "execution.instanceKey">]>
    ]>>]>,
      ForEach<"computes", Sequence<[
      Emit<"SolTemporalComputedEvent", [Hook<"name", "solidity.identifier.escape", "computes.name">, Nested<"params", Sequence<[Emit<"SolTemporalUintValueParam", []>]>>]>
    ]>>,
      ForEach<"postings", Sequence<[
      Emit<"SolTemporalPostingEvent", [Hook<"name", "solidity.identifier.escape", "postings.name">, Direct<"direction", "postings.direction">, Nested<"params", Sequence<[
      Emit<"SolTemporalPostingPartyParam", []>,
      Emit<"SolTemporalPostingAmountParam", []>,
      Emit<"SolTemporalPostingCurrencyParam", []>,
      OptionalOp<"postingMemo", Sequence<[Emit<"SolTemporalPostingMemoParam", []>]>>
    ]>>]>
    ]>>,
      Emit<"SolTemporalReconciledEvent", [Hook<"name", "solidity.identifier.escape", "execution.procedure">, Nested<"params", Sequence<[
      Emit<"SolTemporalStringKeyParam", [Hook<"name", "solidity.identifier.escape", "execution.instanceKey">]>
    ]>>]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalStatusStorage", []>,
      Emit<"SolTemporalClaimStorage", []>,
      Emit<"SolTemporalGroupStorage", []>,
      Emit<"SolTemporalNetStorage", []>,
      Emit<"SolTemporalDebitStorage", []>,
      Emit<"SolTemporalCreditStorage", []>,
      ForEach<"temporalPolicies", Sequence<[
      Emit<"SolTemporalPolicyStorage", [Hook<"policy", "solidity.identifier.escape", "temporalPolicies.name">]>
    ]>>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalConstructor", [Nested<"params", Sequence<[
      ForEach<"temporalPolicies", Sequence<[
      Emit<"SolTemporalPolicyParam", [Hook<"policy", "solidity.identifier.escape", "temporalPolicies.name">]>
    ]>>
    ]>>, Nested<"body", Sequence<[
      ForEach<"temporalPolicies", Sequence<[
      Emit<"SolTemporalGuardRequire", [Hook<"policy", "solidity.identifier.escape", "temporalPolicies.name">]>,
      Emit<"SolTemporalGuardAssign", [Hook<"policy", "solidity.identifier.escape", "temporalPolicies.name">]>
    ]>>
    ]>>]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalExecute", [Nested<"params", Sequence<[
      ForEach<"params", Sequence<[
      Emit<"SolTemporalExecuteParam", [Hook<"name", "solidity.identifier.escape", "params.name">, Hook<"type", "solidity.type.spell", "params.type">]>
    ]>>
    ]>>, Nested<"body", Sequence<[
      Emit<"SolTemporalReplayKey", [Hook<"key", "solidity.identifier.escape", "execution.replayKey">]>,
      Emit<"SolTemporalReplayRequire", [Direct<"status", "successRole.status">]>,
      Emit<"SolTemporalClaimNames", [Direct<"count", "execution.claimInputCount">]>,
      Emit<"SolTemporalClaimCategories", [Direct<"count", "execution.claimInputCount">]>,
      Emit<"SolTemporalClaimValues", [Direct<"count", "execution.claimInputCount">]>,
      ForEach<"claimInputs", Sequence<[
      Emit<"SolTemporalClaimNameAssign", [Hook<"name", "solidity.string.escape", "claimInputs.name">, Direct<"ordinal", "claimInputs.ordinal">]>,
      Emit<"SolTemporalClaimCategoryAssign", [Hook<"category", "solidity.string.escape", "claimInputs.category">, Direct<"ordinal", "claimInputs.ordinal">]>,
      Emit<"SolTemporalClaimValueAssign", [Hook<"value", "solidity.operand.format", "claimInputs.value">, Direct<"ordinal", "claimInputs.ordinal">]>
    ]>>,
      Emit<"SolTemporalClaim", [Hook<"identity", "solidity.string.escape", "execution.coordinationIdentity">, Hook<"key", "solidity.identifier.escape", "execution.instanceKey">]>,
      Emit<"SolTemporalClaimRequire", []>,
      Emit<"SolTemporalTriggerEmit", [Hook<"event", "solidity.identifier.escape", "execution.invokedEvent">, Hook<"key", "solidity.identifier.escape", "execution.instanceKey">]>,
      Emit<"SolTemporalBlank", []>,
      ForEach<"computes", Sequence<[
      Emit<"SolTemporalComputeDecl", [Hook<"name", "solidity.identifier.escape", "computes.name">, Hook<"expression", "solidity.expression.leaf", "computes.expression">]>,
      Emit<"SolTemporalComputeEmit", [Hook<"name", "solidity.identifier.escape", "computes.name">]>
    ]>>,
      Emit<"SolTemporalProgress", []>,
      Emit<"SolTemporalBlank", []>,
      ForEach<"effectGroups", Sequence<[
      Emit<"SolTemporalGroupGuard", [Hook<"policy", "solidity.identifier.escape", "effectGroups.policy">, Direct<"ordinal", "effectGroups.ordinal">, Nested<"body", Sequence<[
      ForEach<"groupPostings", Sequence<[
      Emit<"SolTemporalNetUpdate", [Hook<"ledger", "solidity.string.escape", "groupPostings.ledger">, Direct<"direction", "groupPostings.direction">, Hook<"amount", "solidity.operand.format", "groupPostings.amount">]>,
      Emit<"SolTemporalTotalUpdate", [Direct<"direction", "groupPostings.direction">, Hook<"amount", "solidity.operand.format", "groupPostings.amount">]>,
      Emit<"SolTemporalPostingEmit", [Hook<"name", "solidity.identifier.escape", "groupPostings.name">, Direct<"direction", "groupPostings.direction">, Nested<"args", Sequence<[
      Emit<"SolTemporalPostingArgs", [Hook<"party", "solidity.operand.format", "groupPostings.party">, Hook<"amount", "solidity.operand.format", "groupPostings.amount">, Hook<"currency", "solidity.operand.format", "groupPostings.currency">, Nested<"memo", Sequence<[
      OptionalOp<"groupPostingMemo", Sequence<[
      Emit<"SolTemporalMemoArg", [Hook<"memo", "solidity.string.escape", "groupPostings.memo">]>
    ]>>
    ]>>]>
    ]>>]>
    ]>>,
      Emit<"SolTemporalGroupFlag", [Direct<"ordinal", "effectGroups.ordinal">]>,
      Emit<"SolTemporalProgressAssign", []>
    ]>>]>
    ]>>,
      Emit<"SolTemporalPinClaim", [Nested<"body", Sequence<[Emit<"SolTemporalPinClaimAssign", []>]>>]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalDone", [Nested<"terms", Sequence<[
      ForEach<"effectGroups", Sequence<[
      Emit<"SolTemporalDoneTerm", [Direct<"ordinal", "effectGroups.ordinal">]>
    ]>>
    ]>>]>,
      Emit<"SolTemporalTerminal", [Nested<"body", Sequence<[
      ForEach<"balanceAssertions", Sequence<[Emit<"SolTemporalBalance", []>]>>,
      Emit<"SolTemporalTransition", [Direct<"status", "successRole.status">]>,
      Emit<"SolTemporalReconciledEmit", [Hook<"name", "solidity.identifier.escape", "execution.procedure">, Hook<"key", "solidity.identifier.escape", "execution.instanceKey">]>
    ]>>]>
    ]>>]>
    ]>>, Nested<"sourceCanonicalizations", Sequence<[
      ForEach<"sourceCanonicalizations", Sequence<[
      Emit<"SolSourceCanonicalization", [Direct<"canonicalization", "sourceCanonicalizations.canonicalization">]>
    ]>>
    ]>>]>
    ]>>;
