def SolTemporalAuthorityCommentNode
    : TargetNode<"SolTemporalAuthorityComment", "SolStatement", [],
                 "doc-comment",
                 ["that participants accept; authoritative state stays in their own systems."]>;
def SolTemporalKeyCommentNode
    : TargetNode<"SolTemporalKeyComment", "SolStatement", [],
