def SolTemporalGeneratedCommentNode
    : TargetNode<"SolTemporalGeneratedComment", "SolStatement", [],
                 "doc-comment",
                 ["Generated by the Neutrino Translator from verified MLIR."]>;
def SolTemporalCoordinationCommentNode
    : TargetNode<"SolTemporalCoordinationComment", "SolStatement", [],
                 "doc-comment",
                 ["COORDINATION CONTRACT — not the source of truth and not fund custody."]>;
def SolTemporalCheckpointCommentNode
    : TargetNode<"SolTemporalCheckpointComment", "SolStatement", [],
                 "doc-comment",
