//===- SolidityEvidenceIdiomRecipes.td -  Solidity evidence recipe ---===//
//
// Complete declarative composition for the evidence acceptance rail (the
// QuorumAcceptance.Single / Evidence key). Built in the / paradigm: the
// recipe chooses every target node and its nesting; the provider only binds
// finalized projection facts and performs the closed leaf formatting. This
// replaces the handwritten `materializeEvidenceIdiom`.
//
// Included LAST by SolidityIdiomRecipes.td so it reuses the temporal package's
// FinalizedTemporal* input types, the SolTemporal*/SolEffectful* target nodes,
// the ValueNode/StatementNode helpers, and the registered leaf hooks. The only
// evidence-specific pieces are the "Accepted" event/emit suffix, the
// `== Status.<initial>` replay predicate, the five evidence doc comments, the
// ordered accept-parameter list (arity-general —  names the instance-key
// parameter, the rest are anonymous), and the evidenceOnly contract assembly.
//
//===----------------------------------------------------------------------===//

// The evidence-specific header doc comments (exact retired-materializer text);
// the "Generated by …" line reuses the shared SolTemporalGeneratedComment.
def SolEvidenceOnlyCommentNode
    : TargetNode<"SolEvidenceOnlyComment", "SolStatement", [], "doc-comment",
                 ["EVIDENCE-ONLY COORDINATION — records ACCEPTED attested evidence by instance key and moves"]>;
def SolEvidenceNoLedgerCommentNode
    : TargetNode<"SolEvidenceNoLedgerComment", "SolStatement", [], "doc-comment",
                 ["NO ledger value (no debit/credit, no net positions). Participants accept the on-chain"]>;
def SolEvidenceRecordCommentNode
    : TargetNode<"SolEvidenceRecordComment", "SolStatement", [], "doc-comment",
                 ["acceptance record; authoritative state stays in their own systems. State is keyed by the"]>;
def SolEvidenceKeyCommentNode
    : TargetNode<"SolEvidenceKeyComment", "SolStatement", [], "doc-comment",
                 ["instance key (the idempotency key), so distinct instances never share status."]>;

// The acceptance EVENT `event <Proc>Accepted(string <instanceKey>);` — one
// string param carrying the (raw) instance-key noun.
def SolEvidenceAcceptedEventNode : ValueNode<"SolEvidenceAcceptedEvent",
  "SolStatement", "evidence-accepted-event", [
    TargetField<"name", "leaf", "EscapedIdentifier">,
    TargetField<"params", "nodes", "SolTemporalParam", "many", 1, "1">]>;

// accept() ordered parameter (arity-general): the type is the projected,
// calldata-located type token; the name is EMPTY for every parameter except the
//  instance-key parameter, for which the provider emits the `u_`-spelled
// (ref) name. The recipe binds uniformly — the key-vs-anonymous decision is the
// provider's mechanical consumption of the finalized isInstanceKey role.
def SolEvidenceParamNode : ValueNode<"SolEvidenceParam", "SolTemporalParam",
  "evidence-param", [
    TargetField<"type", "leaf", "TargetTypeToken">,
    TargetField<"name", "leaf", "EscapedIdentifier">]>;

// The acceptance emission `emit <Proc>Accepted(<u_key>);`.
def SolEvidenceAcceptEmitNode : StatementNode<"SolEvidenceAcceptEmit",
  "evidence-accept-emit", [
    TargetField<"name", "leaf", "EscapedIdentifier">,
    TargetField<"key", "leaf", "EscapedIdentifier">]>;

// The accept() function: the ordered projected parameters + the fixed body.
def SolEvidenceAcceptNode : ValueNode<"SolEvidenceAccept", "SolStatement",
  "evidence-accept", [
    TargetField<"params", "nodes", "SolTemporalParam", "many", 1, "unbounded">,
    TargetField<"body", "nodes", "SolStatement", "many", 5, "5">]>;

// The evidence contract (evidenceOnly typed contract; renders through the same
// SolidityContract renderer as the retired materializeEvidenceIdiom output).
def SolEvidenceContractNode : TargetNode<"SolEvidenceContract",
  "SolTemporalContractModel", [
    TargetField<"name", "leaf", "EscapedIdentifier">,
    TargetField<"header", "nodes", "SolStatement", "many", 14, "14">,
    TargetField<"body", "nodes", "SolStatement", "many", 1, "unbounded">,
    TargetField<"sourceCanonicalizations", "nodes",
                "SolSourceCanonicalization", "many", 1, "1">
  ], "evidence-contract">;

def SolidityEvidenceContractRecipe : TargetIdiomRecipe<
  "solidity.evidence.contract.v1", "solidity",
  "QuorumAcceptance.Single", "Evidence", "NotApplicable", [
    One<"evidenceExecution", "FinalizedTemporalExecution">,
    One<"evidenceInitialRole", "FinalizedTemporalRole">,
    One<"evidenceSuccessRole", "FinalizedTemporalRole">,
    Many<"evidenceSourceCanonicalizations", "FinalizedSourceCanonicalization", 1, "1", "evidenceSourceCanonicalizations.ordinal">,
    Many<"evidenceParams", "FinalizedTemporalParam", 1, "unbounded", "evidenceParams.ordinal">
  ],
  "SolTemporalContractModel", CardinalityOne,
  Sequence<[
      Emit<"SolEvidenceContract", [Hook<"name", "solidity.identifier.escape", "evidenceExecution.procedure">, Nested<"header", Sequence<[
      Emit<"SolTemporalSpdx", []>,
      Emit<"SolTemporalPragma", []>,
      Emit<"SolTemporalBlank", []>,
      Call<"solidity.guard-consumer.evidence.v1", []>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalGeneratedComment", []>,
      Emit<"SolEvidenceOnlyComment", []>,
      Emit<"SolEvidenceNoLedgerComment", []>,
      Emit<"SolEvidenceRecordComment", []>,
      Emit<"SolEvidenceKeyComment", []>
    ]>>, Nested<"body", Sequence<[
      Emit<"SolStatusEnum", [Direct<"initial", "evidenceInitialRole.status">, Direct<"success", "evidenceSuccessRole.status">]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolEvidenceAcceptedEvent", [Hook<"name", "solidity.identifier.escape", "evidenceExecution.procedure">, Nested<"params", Sequence<[
      Emit<"SolTemporalStringKeyParam", [Hook<"name", "solidity.identifier.escape", "evidenceExecution.instanceKey">]>
    ]>>]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalStatusStorage", []>,
      Emit<"SolEffectfulGuardStorage", []>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolTemporalConstructor", [Nested<"params", Sequence<[Emit<"SolEffectfulGuardParam", []>]>>, Nested<"body", Sequence<[
      Emit<"SolEffectfulGuardRequire", []>,
      Emit<"SolEffectfulGuardAssign", []>
    ]>>]>,
      Emit<"SolTemporalBlank", []>,
      Emit<"SolEvidenceAccept", [Nested<"params", Sequence<[
      ForEach<"evidenceParams", Sequence<[
      Emit<"SolEvidenceParam", [Hook<"type", "solidity.type.spell", "evidenceParams.type">, Hook<"name", "solidity.identifier.escape", "evidenceParams.name">]>
    ]>>
    ]>>, Nested<"body", Sequence<[
      Emit<"SolTemporalReplayKey", [Hook<"key", "solidity.identifier.escape", "evidenceExecution.replayKey">]>,
      Emit<"SolEffectfulExecuteReplayRequire", [Direct<"status", "evidenceInitialRole.status">]>,
      Emit<"SolEffectfulGuardAcceptance", []>,
      Emit<"SolTemporalTransition", [Direct<"status", "evidenceSuccessRole.status">]>,
      Emit<"SolEvidenceAcceptEmit", [Hook<"name", "solidity.identifier.escape", "evidenceExecution.procedure">, Hook<"key", "solidity.identifier.escape", "evidenceExecution.instanceKey">]>
    ]>>]>
    ]>>, Nested<"sourceCanonicalizations", Sequence<[
      ForEach<"evidenceSourceCanonicalizations", Sequence<[
      Emit<"SolSourceCanonicalization", [Direct<"canonicalization", "evidenceSourceCanonicalizations.canonicalization">]>
    ]>>
    ]>>]>
    ]>>;
