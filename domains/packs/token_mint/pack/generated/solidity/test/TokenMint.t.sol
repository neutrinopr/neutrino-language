pragma solidity ^0.8.20;

import "../src/TokenMint.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

/// Generated by the Neutrino Translator from scenario "token_mint_happy_path".
contract TokenMintTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    TokenMint c;

    string constant MINT_ID = "mint-001";
    string constant SUPPLY_ID = "token-reserve";
    string constant HOLDER_ID = "holder-001";
    uint256 constant AMOUNT = 2500;
    string constant CURRENCY = "EUR";
    uint256 constant SUPPLY_APPROVED = 1;
    string constant MINT_ID_2 = "mint-001-2";


    event MintRequested(string mint_id);
    event SupplyDebitDebited(string party, uint256 amount, string currency);
    event HolderCreditCredited(string party, uint256 amount, string currency);
    event TokenMintReconciled(string mint_id);

    function setUp() public {
        c = new TokenMint();
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(MINT_ID));
    }

    function test_happy_path_reaches_reconciled_with_events() public {
        bytes32 _k = _key();
        c.attest(MINT_ID);
        vm.expectEmit(true, true, true, true);
        emit MintRequested(MINT_ID);
        vm.expectEmit(true, true, true, true);
        emit SupplyDebitDebited(SUPPLY_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit HolderCreditCredited(HOLDER_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit TokenMintReconciled(MINT_ID);
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        require(uint256(c.statusOf(_k)) == uint256(TokenMint.Status.Reconciled), "status");
        require(c.debitTotal(_k) == c.creditTotal(_k), "balanced");
        require(c.debitTotal(_k) == AMOUNT, "debit total");
        require(c.net(_k, "token.balance") == int256(2500), "net token.balance");
        require(c.net(_k, "token.supply") == int256(-2500), "net token.supply");
    }

    function test_replay_is_safe_no_double_debit() public {
        bytes32 _k = _key();
        c.attest(MINT_ID);
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        vm.expectRevert(bytes("replay"));
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        require(c.debitTotal(_k) == AMOUNT, "no double debit");
    }

    function test_missing_attestation_rejected() public {
        vm.expectRevert(bytes("missing attestation"));
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
    }

    function test_invalid_transition_ordering_rejected() public {
        c.attest(MINT_ID);
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        vm.expectRevert(bytes("bad transition"));
        c.attest(MINT_ID);
    }

    function test_balanced_invariant_holds() public {
        bytes32 _k = _key();
        c.attest(MINT_ID);
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        require(c.debitTotal(_k) == c.creditTotal(_k), "debit==credit");
    }

    function test_workflows_are_isolated_per_key() public {
        c.attest(MINT_ID);
        c.execute(MINT_ID, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        c.attest(MINT_ID_2);
        c.execute(MINT_ID_2, SUPPLY_ID, HOLDER_ID, AMOUNT, CURRENCY, SUPPLY_APPROVED);
        // each workflow key keeps its own totals; no sharing/double counting
        require(c.debitTotal(keccak256(bytes(MINT_ID))) == AMOUNT, "k1 total");
        require(c.debitTotal(keccak256(bytes(MINT_ID_2))) == AMOUNT, "k2 total");
    }
}
