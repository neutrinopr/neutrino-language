pragma solidity ^0.8.20;

import "../src/SponsoredOfferAgreement.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

/// Generated by the Neutrino Translator from scenario "sponsored_offer_agreement_happy_path".
contract SponsoredOfferAgreementTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    SponsoredOfferAgreement c;

    string constant OFFER_ID = "offer-001";
    string constant SPONSOR_ID = "sponsor-001";
    string constant MERCHANT_ID = "merchant-001";
    uint256 constant CONTRIBUTION = 5000;
    string constant CURRENCY = "EUR";
    string constant OFFER_ID_2 = "offer-001-2";


    event SponsoredOfferProposed(string offer_id);
    event SponsorCommitmentDebited(string party, uint256 amount, string currency);
    event MerchantExpectedContributionCredited(string party, uint256 amount, string currency);
    event SponsoredOfferAgreementReconciled(string offer_id);

    function setUp() public {
        c = new SponsoredOfferAgreement();
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(OFFER_ID));
    }

    function test_happy_path_reaches_reconciled_with_events() public {
        bytes32 _k = _key();
        c.attest(OFFER_ID);
        vm.expectEmit(true, true, true, true);
        emit SponsoredOfferProposed(OFFER_ID);
        vm.expectEmit(true, true, true, true);
        emit SponsorCommitmentDebited(SPONSOR_ID, CONTRIBUTION, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit MerchantExpectedContributionCredited(MERCHANT_ID, CONTRIBUTION, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit SponsoredOfferAgreementReconciled(OFFER_ID);
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        require(uint256(c.statusOf(_k)) == uint256(SponsoredOfferAgreement.Status.Reconciled), "status");
        require(c.debitTotal(_k) == c.creditTotal(_k), "balanced");
        require(c.debitTotal(_k) == CONTRIBUTION, "debit total");
        require(c.net(_k, "merchant.expected_contribution") == int256(5000), "net merchant.expected_contribution");
        require(c.net(_k, "sponsor.commitment") == int256(-5000), "net sponsor.commitment");
    }

    function test_replay_is_safe_no_double_debit() public {
        bytes32 _k = _key();
        c.attest(OFFER_ID);
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        vm.expectRevert(bytes("replay"));
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        require(c.debitTotal(_k) == CONTRIBUTION, "no double debit");
    }

    function test_missing_attestation_rejected() public {
        vm.expectRevert(bytes("missing attestation"));
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
    }

    function test_invalid_transition_ordering_rejected() public {
        c.attest(OFFER_ID);
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        vm.expectRevert(bytes("bad transition"));
        c.attest(OFFER_ID);
    }

    function test_balanced_invariant_holds() public {
        bytes32 _k = _key();
        c.attest(OFFER_ID);
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        require(c.debitTotal(_k) == c.creditTotal(_k), "debit==credit");
    }

    function test_workflows_are_isolated_per_key() public {
        c.attest(OFFER_ID);
        c.execute(OFFER_ID, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        c.attest(OFFER_ID_2);
        c.execute(OFFER_ID_2, SPONSOR_ID, MERCHANT_ID, CONTRIBUTION, CURRENCY);
        // each workflow key keeps its own totals; no sharing/double counting
        require(c.debitTotal(keccak256(bytes(OFFER_ID))) == CONTRIBUTION, "k1 total");
        require(c.debitTotal(keccak256(bytes(OFFER_ID_2))) == CONTRIBUTION, "k2 total");
    }
}
