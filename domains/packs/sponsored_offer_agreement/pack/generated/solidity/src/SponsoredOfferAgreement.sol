pragma solidity ^0.8.20;

/// Generated by the Neutrino Translator from verified MLIR.
/// COORDINATION CONTRACT — not the source of truth and not fund custody.
/// It records coordination checkpoints (status, attestations, net positions)
/// that participants accept; authoritative state stays in their own systems.
/// All coordination state is keyed by the workflow key (the idempotency key),
/// so distinct workflow instances never share status, totals, or net positions.
contract SponsoredOfferAgreement {
    enum Status { None, Reconciled }

    event SponsoredOfferProposed(string offer_id);
    event SponsorCommitmentDebited(string party, uint256 amount, string currency);
    event MerchantExpectedContributionCredited(string party, uint256 amount, string currency);
    event SponsoredOfferAgreementReconciled(string offer_id);

    mapping(bytes32 => Status) public statusOf;
    mapping(bytes32 => bool) public attested;
    mapping(bytes32 => mapping(string => int256)) public net;  // key -> ledger -> net
    mapping(bytes32 => uint256) public debitTotal;             // key -> total debited
    mapping(bytes32 => uint256) public creditTotal;            // key -> total credited

    function attest(string calldata u_offer_id) external {
        bytes32 _k = keccak256(bytes(u_offer_id));
        require(statusOf[_k] == Status.None, "bad transition");
        attested[_k] = true;
    }

    function execute(string calldata u_offer_id, string calldata u_sponsor_id, string calldata u_merchant_id, uint256 u_contribution, string calldata u_currency) external {
        bytes32 _k = keccak256(bytes(u_offer_id));
        require(statusOf[_k] == Status.None, "replay");
        require(attested[_k], "missing attestation");
        emit SponsoredOfferProposed(u_offer_id);


        net[_k]["sponsor.commitment"] -= int256(u_contribution);
        debitTotal[_k] += u_contribution;
        emit SponsorCommitmentDebited(u_sponsor_id, u_contribution, u_currency);
        net[_k]["merchant.expected_contribution"] += int256(u_contribution);
        creditTotal[_k] += u_contribution;
        emit MerchantExpectedContributionCredited(u_merchant_id, u_contribution, u_currency);

        require(debitTotal[_k] == creditTotal[_k], "not balanced");
        statusOf[_k] = Status.Reconciled;
        emit SponsoredOfferAgreementReconciled(u_offer_id);
    }
}
