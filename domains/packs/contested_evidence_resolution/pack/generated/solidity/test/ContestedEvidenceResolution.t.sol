pragma solidity ^0.8.20;

import "../src/ContestedEvidenceResolution.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

contract MockQuorumGuard {
    mapping(bytes32 => bool) public accepted;
    function setAccepted(bytes32 claimId, bool v) external {
        accepted[claimId] = v;
    }
    function isAccepted(bytes32 claimId) external view returns (bool) {
        return accepted[claimId];
    }
}

/// Generated by the Neutrino Translator from scenario "contested_evidence_resolution_quorum_accepted".
contract ContestedEvidenceResolutionTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    ContestedEvidenceResolution c;
    MockQuorumGuard guard;

    string constant RESOLUTION_ID = "resolution-2026-08-01-0001";
    string constant RESOLUTION_EVIDENCE = "sha256:3c2f1a7d9b4e6058c1d2a3b4c5d6e7f80912a3b4c5d6e7f8091a2b3c4d5e6f70";
    string constant RESOLUTION_ID_2 = "resolution-2026-08-01-0001-2";

    event ContestedEvidenceResolutionAccepted(string resolution_id);

    function setUp() public {
        guard = new MockQuorumGuard();
        c = new ContestedEvidenceResolution(address(guard));
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(RESOLUTION_ID));
    }

    function test_accept_records_evidence_and_emits() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(RESOLUTION_ID)), true);
        vm.expectEmit(true, true, true, true);
        emit ContestedEvidenceResolutionAccepted(RESOLUTION_ID);
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(ContestedEvidenceResolution.Status.Accepted), "accepted");
    }

    function test_replay_is_refused() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(RESOLUTION_ID)), true);
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
        vm.expectRevert(bytes("replay"));
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(ContestedEvidenceResolution.Status.Accepted), "still accepted");
    }

    function test_unaccepted_quorum_rejected() public {
        vm.expectRevert(bytes("quorum not accepted"));
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
    }

    function test_accepted_quorum_proceeds() public {
        bytes32 _k = _key();
        guard.setAccepted(keccak256(bytes(RESOLUTION_ID)), true);
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
        require(uint256(c.statusOf(_k)) == uint256(ContestedEvidenceResolution.Status.Accepted), "gated status");
    }

    function test_instances_are_isolated_per_key() public {
        guard.setAccepted(keccak256(bytes(RESOLUTION_ID)), true);
        c.accept(RESOLUTION_ID, RESOLUTION_EVIDENCE);
        guard.setAccepted(keccak256(bytes(RESOLUTION_ID_2)), true);
        c.accept(RESOLUTION_ID_2, RESOLUTION_EVIDENCE);
        // each instance key keeps its own status; no sharing
        require(uint256(c.statusOf(keccak256(bytes(RESOLUTION_ID)))) == uint256(ContestedEvidenceResolution.Status.Accepted), "k1 status");
        require(uint256(c.statusOf(keccak256(bytes(RESOLUTION_ID_2)))) == uint256(ContestedEvidenceResolution.Status.Accepted), "k2 status");
    }
}
