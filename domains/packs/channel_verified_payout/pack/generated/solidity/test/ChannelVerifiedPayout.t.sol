pragma solidity ^0.8.20;

import "../src/ChannelVerifiedPayout.sol";

interface Vm {
    function expectRevert(bytes calldata) external;
    function expectEmit(bool, bool, bool, bool) external;
}

/// Generated by the Neutrino Translator from scenario "channel_verified_payout_happy_path".
contract ChannelVerifiedPayoutTest {
    Vm constant vm = Vm(0x7109709ECfa91a80626fF3989D68f67F5b1DD12D);
    ChannelVerifiedPayout c;

    string constant PAYOUT_ID = "pay-001";
    string constant PAYER_ID = "payer-001";
    string constant RECIPIENT_ID = "recipient-001";
    uint256 constant AMOUNT = 100;
    string constant CURRENCY = "EUR";
    string constant PAYOUT_ID_2 = "pay-001-2";


    event PayoutAuthorized(string payout_id);
    event PayerFundingDebited(string party, uint256 amount, string currency);
    event RecipientSettlementCredited(string party, uint256 amount, string currency);
    event ChannelVerifiedPayoutReconciled(string payout_id);

    function setUp() public {
        c = new ChannelVerifiedPayout();
    }

    function _key() internal pure returns (bytes32) {
        return keccak256(bytes(PAYOUT_ID));
    }

    function test_happy_path_reaches_reconciled_with_events() public {
        bytes32 _k = _key();
        c.attest(PAYOUT_ID);
        vm.expectEmit(true, true, true, true);
        emit PayoutAuthorized(PAYOUT_ID);
        vm.expectEmit(true, true, true, true);
        emit PayerFundingDebited(PAYER_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit RecipientSettlementCredited(RECIPIENT_ID, AMOUNT, CURRENCY);
        vm.expectEmit(true, true, true, true);
        emit ChannelVerifiedPayoutReconciled(PAYOUT_ID);
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        require(uint256(c.statusOf(_k)) == uint256(ChannelVerifiedPayout.Status.Reconciled), "status");
        require(c.debitTotal(_k) == c.creditTotal(_k), "balanced");
        require(c.debitTotal(_k) == AMOUNT, "debit total");
        require(c.net(_k, "payer.funding") == int256(-100), "net payer.funding");
        require(c.net(_k, "recipient.settlement") == int256(100), "net recipient.settlement");
    }

    function test_replay_is_safe_no_double_debit() public {
        bytes32 _k = _key();
        c.attest(PAYOUT_ID);
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        vm.expectRevert(bytes("replay"));
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        require(c.debitTotal(_k) == AMOUNT, "no double debit");
    }

    function test_missing_attestation_rejected() public {
        vm.expectRevert(bytes("missing attestation"));
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
    }

    function test_invalid_transition_ordering_rejected() public {
        c.attest(PAYOUT_ID);
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        vm.expectRevert(bytes("bad transition"));
        c.attest(PAYOUT_ID);
    }

    function test_balanced_invariant_holds() public {
        bytes32 _k = _key();
        c.attest(PAYOUT_ID);
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        require(c.debitTotal(_k) == c.creditTotal(_k), "debit==credit");
    }

    function test_workflows_are_isolated_per_key() public {
        c.attest(PAYOUT_ID);
        c.execute(PAYOUT_ID, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        c.attest(PAYOUT_ID_2);
        c.execute(PAYOUT_ID_2, PAYER_ID, RECIPIENT_ID, AMOUNT, CURRENCY);
        // each workflow key keeps its own totals; no sharing/double counting
        require(c.debitTotal(keccak256(bytes(PAYOUT_ID))) == AMOUNT, "k1 total");
        require(c.debitTotal(keccak256(bytes(PAYOUT_ID_2))) == AMOUNT, "k2 total");
    }
}
