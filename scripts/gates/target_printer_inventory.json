  "genericFramingHandlers": [
    {
      "target": "solidity",
      "node": "Blank",
      "note": "bare pass-through (empty line) \u2014 generic layout primitive, carries no target syntax"
    },
    {
      "target": "solidity",
      "node": "Line",
      "note": "bare pass-through (${text}) \u2014 verbatim already-legalized line; carries no .td syntax, NOT credited as a migrated typed-syntax node"
    },
    {
      "target": "solidity",
      "node": "Block",
      "note": "bare pass-through (${text} \u2026 ${close}) \u2014 generic framing delimiters authored by legalization; NOT credited as a migrated typed-syntax node"
    },
    {
      "target": "postgres",
      "node": "Blank",
      "note": "fieldless empty-line framing only \u2014 carries no operands, domain/decision payload, or target SQL bytes; any payload-bearing shape is not generic framing"
    }
  ],
