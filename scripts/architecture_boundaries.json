{
  "_note": "Architecture boundary allowlists ( /  S3). Reviewed config for check_architecture_boundaries.py. The scanner keeps backend- and domain-specific names out of the backend-agnostic, domain-agnostic compiler CORE (the .neu frontend + neutrino IR/dialect + kernel). Comments are stripped before scanning, so this governs CODE coupling (string literals / identifiers), not prose that merely documents a lowering. Prefer editing these small lists over embedding magic strings in the scanner.",
  "scan_roots": [
    "include",
    "lib",
    "tools"
  ],
  "scan_extensions": [
    ".h",
    ".hpp",
    ".hh",
    ".c",
    ".cc",
    ".cpp",
    ".td"
  ],
  "min_files_scanned": 40,
  "backend": {
    "_doc": "Controlled backend identifiers. In CODE they may appear ONLY in files matching allowed_path_globs (the backend renderers, the target registry/profiles, the shared expression-lowering AST, the artifact manifest, and the CLI tools). Anywhere else in the C++ surface is a core-coupling violation.",
    "tokens": [
      "solidity",
      "postgres"
    ],
    "allowed_path_globs": [
      "include/Neutrino/Gen*.h",
      "lib/Gen*.h",
      "lib/targets/*Target.cpp",
      "include/Neutrino/Target*.h",
      "lib/emit/Target*.cpp",
      "include/Neutrino/Expr.h",
      "include/Neutrino/Manifest.h",
      "lib/Manifest.cpp",
      "include/Neutrino/SpecLegality.h",
      "lib/SpecLegality.cpp",
      "include/Neutrino/PlanLegality.h",
      "lib/PlanLegality.cpp",
      "include/Neutrino/Emit.h",
      "lib/backends/*/*.cpp",
      "lib/backends/*/*.td",
      "lib/backends/*/test/*.cpp",
      "lib/slots/Gen*.cpp",
      "lib/policy/*/Gen*.cpp",
      "lib/policy/*/test/*.cpp",
      "lib/spec-contract/Expr.cpp",
      "tools/**"
    ]
  },
  "domain": {
    "_doc": "Sample/domain names are the union of live examples/domains/<name>/ directories and the persistent externalized-domain registry. In CODE they may appear nowhere in the C++ surface \u2014 the core compiler is domain-agnostic, so there is no allowlist. Externalized identities remain governed after their live directories are deleted. `min_domain_vocab` fails the scan closed if discovery plus the registry yields fewer than this many domains.",
    "domains_dir": "examples/domains",
    "externalized_registry": "docs/externalized-domain-registry.json",
    "min_domain_vocab": 10,
    "allowed_path_globs": []
  },
  "root_scripts": {
    "_doc": "Consumes the  tooling boundary AND the  (B3) role layout: domain/corpus/rail/sample tooling lives in scripts/{domain,corpus,rails,samples}/, and the base-compiler scripts are organized by ROLE under scripts/{gates,validators,generators}/ \u2014 so each scanned dir below must hold only the files in its `allowed` list, or a marked transitional wrapper (any file containing `wrapper_marker`). A NEW *.py in a scanned dir that is neither is a boundary violation \u2014 either it belongs in a different role/domain subtree, or it is a new script that must be consciously added to that dir's `allowed`. Per-dir `min_files` fails closed on a mis-rooted/empty scan. The flat scripts/ ROOT now holds only build/release/quality-infra scripts + the transitional wrappers + data files.",
    "wrapper_marker": "TRANSITIONAL wrapper (",
    "dirs": [
      {
        "path": "scripts",
        "min_files": 2,
        "allowed": [
          "mutation_test.py",
          "property_test.py"
        ]
      },
      {
